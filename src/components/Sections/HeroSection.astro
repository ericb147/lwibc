---
import Button from "../UI/Button.astro";

export interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
  videoSrc?: string;
  posterSrc?: string;
}

const {
  title = "Welcome to Living Waters Independent Baptist Church",
  subtitle = "Preaching the Word. Proclaiming the Gospel.",
  ctaText = "Plan Your Visit",
  ctaLink = "/im-new",
  videoSrc = "/uploads/hero.mp4",
  posterSrc = "/uploads/hero-still.webp"
} = Astro.props;
---

<section class="relative h-[70vh] min-h-[500px] w-full overflow-hidden bg-black pt-20" id="hero">
  <video
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={posterSrc}
    class="absolute inset-0 z-0 h-full w-full object-cover motion-reduce:hidden"
    aria-hidden="true"
  >
    <source src={videoSrc} />
  </video>

  <div
    class="absolute inset-0 z-0 hidden bg-cover bg-center motion-reduce:block"
    style={`background-image: url('${posterSrc}')`}
    aria-hidden="true"
  ></div>

  <div class="absolute inset-0 z-10" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6));"></div>

  <div class="container relative z-20 mx-auto px-4">
    <div class="flex min-h-[calc(70vh-5rem)] items-center">
      <div class="max-w-3xl text-white">
        <h1 class="mb-4 text-4xl font-bold leading-tight text-white md:text-6xl">
          {title}
        </h1>
        <p class="mb-8 text-xl text-white md:text-2xl">
          {subtitle}
        </p>

        <div class="flex flex-wrap gap-4">
          <Button href={ctaLink} variant="primary" size="lg">
            {ctaText}
          </Button>

          <Button
            href="/sermons"
            variant="outline"
            size="lg"
            class="bg-white/10 text-white border-white hover:bg-white hover:text-gray-900 backdrop-blur-sm transition-all"
          >
            Watch Sermons
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>